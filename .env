# Copie este arquivo para ".env" e preencha os valores antes de rodar o servidor.
# Nunca faça commit do arquivo ".env" real no controle de versão.

# Porta em que o servidor HTTP/WebSocket vai rodar
PORT=3000

# Segredo usado para assinar os tokens JWT. Troque por uma string longa e aleatória.
JWT_SECRET=troque-esta-chave-por-um-segredo-forte-e-unico

# Tempo de expiração do token de login
JWT_EXPIRES_IN=7d

# Caminho do arquivo do banco SQLite (criado automaticamente na primeira execução)
DB_PATH=./data/drivelink.db

# Origem(ns) permitidas para CORS (separadas por vírgula). Use "*" apenas em desenvolvimento.
CORS_ORIGIN=*
